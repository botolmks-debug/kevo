# Salin file ini ke .env.local dan isi dengan nilai dari project Supabase (dev).
# JANGAN commit .env.local atau nilai asli apa pun.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dipakai di server saja, belum diperlukan di irisan ini.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — WAJIB diisi untuk semua upload baru (Database Gambar, Logo,
# hasil generate konten/video). Ambil dari Cloudinary Dashboard > Settings >
# API Keys. Data lama tetap di Supabase Storage, tidak perlu Cloudinary untuk
# baca data lama.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
